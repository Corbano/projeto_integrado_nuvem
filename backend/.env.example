ENVIRONMENT=development
DATABASE_URL=sqlite:///./autocenter.db
# Produção (RDS): mysql+pymysql://usuario:senha@endpoint-rds:3306/autocenter
# Gere um segredo forte: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=["http://localhost:5173"]
BCRYPT_ROUNDS=12
# Fotos do check-in: local (dev) ou s3 (produção; credenciais pela role da instância, nunca aqui)
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=sa-east-1
